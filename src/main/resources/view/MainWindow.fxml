<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="460.0"
            styleClass="app-shell"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bot.gui.MainWindow">
    <children>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="41.0"
                   AnchorPane.bottomAnchor="12.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="92.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="41.0"
                AnchorPane.bottomAnchor="12.0"
                AnchorPane.rightAnchor="12.0"
                text="Send" />
        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    fitToWidth="true"
                    AnchorPane.bottomAnchor="65.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0"
                    vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="8.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
